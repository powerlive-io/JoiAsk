{
  "name": "joiask",
  "version": "1.0.0",
  "type": "module",
  "description": "JoiAsk Question Box",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:admin": "cd admin && npm run dev -- -p 3001",
    "dev:backend": "go run cmd/cmd.go",
    "build:frontend": "cd frontend && npm run build",
    "build:admin": "cd admin && npm run build",
    "build": "npm run build:frontend && npm run build:admin",
    "test:content-markup": "node --test shared/content-markup.test.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:typecheck": "tsc --project tests/e2e/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3"
  }
}
